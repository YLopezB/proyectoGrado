# =====================================================================
#  CONFIGURACIÓN DE LA PLATAFORMA  —  copia este archivo a ".env"
#     cp .env.example .env
#  IMPORTANTE: si un valor contiene $ o # enciérralo entre comillas simples: 'abc$123'
# =====================================================================

# ---------- Administrador ----------
# Credenciales del administrador. ADMIN_PASSWORD es la contraseña inicial: el administrador puede
# cambiarla desde la plataforma (Administración > Contraseña) y entonces prevalece la guardada en la base de datos.
ADMIN_USER=admin
ADMIN_PASSWORD=CambiaEstaClave2026!

# ---------- Marca de la empresa (pantalla de inicio de sesión y menú) ----------
# Son los valores iniciales; el administrador puede cambiarlos después en "Empresa" y esos cambios tienen prioridad.
# La foto del login es el archivo frontend/public/img/login-bg.jpg y el logo frontend/public/img/logo.svg
# (reemplázalos por los tuyos o súbelos desde "Empresa").
COMPANY_NAME='Nombre de tu empresa'
COMPANY_SLOGAN='Gestión, comunicación y recursos en un solo lugar'
COMPANY_PRIMARY_COLOR='#184f5b'
COMPANY_ACCENT_COLOR='#e8f0f0'
COMPANY_LOGIN_TEXT='Una solución simple a la comunicación de tu organización'
# Enlace de "Centro de ayuda" (déjalo vacío para ocultarlo)
HELP_URL=
# Crédito del pie del menú
DEVELOPER_NAME='Yeison Andres López Burbano'
DEVELOPER_URL='https://yeisonlopez.dev/'

# ---------- PostgreSQL ----------
POSTGRES_DB=plataforma
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=cambia_esta_clave_de_base_de_datos

# ---------- Seguridad ----------
# Cadenas largas y aleatorias:  openssl rand -hex 32
JWT_SECRET=cambia_este_secreto_jwt_por_uno_largo_y_aleatorio
INTERNAL_API_KEY=cambia_esta_llave_interna_entre_microservicios
JWT_EXPIRES_IN=1h
# Intentos de login FALLIDOS permitidos por IP cada 15 minutos
LOGIN_RATE_LIMIT=10

# ---------- Repositorio de archivos ----------
MAX_FILE_SIZE_MB=50
USER_QUOTA_MB=500
BLOCKED_EXTENSIONS=exe,msi,bat,cmd,com,scr,vbs,ps1,jar,dll

# ---------- Gateway (nginx) ----------
# Producción: puertos publicados por el gateway
HTTP_PORT=80
HTTPS_PORT=443
# Desarrollo: puerto local del gateway
DEV_HTTP_PORT=8080
# Solo producción: nginx.prod.conf (HTTP)  |  nginx.prod.ssl.conf (HTTPS, requiere certs/)
GATEWAY_CONF=nginx.prod.conf
